# Server
NODE_ENV=development
PORT=5000

# Database (Leave empty or unset to use embedded PostgreSQL data at ./backend/data/pgdata)
DATABASE_URL=

# Authentication
JWT_SECRET=researchlens_production_super_secure_jwt_secret_key_2026_dev
JWT_EXPIRES_IN=7d

# Gemini AI API Key (Set your real Gemini API key from Google AI Studio)
GEMINI_API_KEY=

# Research APIs
OPENALEX_API_URL=https://api.openalex.org
CROSSREF_API_URL=https://api.crossref.org

# Frontend
FRONTEND_URL=http://localhost:5173

# File Upload
MAX_FILE_SIZE_MB=20
UPLOAD_DIR=./uploads
